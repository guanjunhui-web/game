    "world_001": {
      "type": "dialogue",
      "chapter": "序章 出发日",
      "background": "bg-heaven.svg",
      "speaker": "narrator",
      "text": "在很久很久以前，在每个人来到这个世界以前，我们都曾经是云端上的小天使。",
      "next": "world_002"
    },
    "world_002": {
      "type": "dialogue",
      "background": "bg-heaven.svg",
      "speaker": "narrator",
      "text": "小天使们睡在云朵做成的摇篮里，用小小的翅膀穿过月光，等待属于自己的出发日。",
      "next": "world_003"
    },
    "world_003": {
      "type": "dialogue",
      "background": "bg-heaven.svg",
      "speaker": "narrator",
      "text": "出发日到来的时候，他们会去星星档案馆，认真看过许多家的光，然后选择自己要出生的家庭。",
      "next": "cloud_001"
    },
    "cloud_001": {
      "type": "dialogue",
      "background": "bg-heaven.svg",
      "speaker": "little_angel",
      "sprite": { "character": "little_angel", "expression": "confused", "position": "left" },
      "text": "今天……轮到我了吗？",
      "next": "cloud_002"
    },
    "cloud_002": {
      "type": "dialogue",
      "background": "bg-heaven.svg",
      "speaker": "guardian",
      "sprite": { "character": "guardian", "expression": "smile", "position": "right" },
      "text": "是的。今天是你的出发日。",
      "next": "cloud_003"
    },
    "cloud_003": {
      "type": "dialogue",
      "background": "bg-heaven.svg",
      "speaker": "little_angel",
      "sprite": { "character": "little_angel", "expression": "worried", "position": "left" },
      "text": "出发以后，我会去哪里？",
      "next": "cloud_004"
