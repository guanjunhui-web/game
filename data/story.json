      "speaker": "guardian",
      "sprite": {
        "character": "guardian",
        "expression": "smile",
        "position": "right"
      },
      "text": "可是很久以前，他们也会摔跤，也会撒娇，也会因为一点小事开心很久。",
      "next": "warm_003d_extra_01"
    },
    "warm_003d2": {
      "type": "dialogue",
      "background": "bg-warm.svg",
