    "trial_final_a": {
      "type": "dialogue",
      "background": "bg-gate.svg",
      "speaker": "little_angel",
      "sprite": {
        "character": "little_angel",
        "expression": "touched",
        "position": "left"
      },
      "text": "我也选择了你们。不是因为你们最耀眼，而是因为你们还没有见到我，就已经把灯点亮了。",
      "next": "xingyu_bless"
    },
    "trial_final_b": {
      "type": "dialogue",
      "background": "bg-gate.svg",
      "speaker": "little_angel",
      "sprite": {
        "character": "little_angel",
        "expression": "touched",
        "position": "left"
      },
      "text": "我想成为你们的孩子。想在害怕的时候被抱住，想在摔倒的时候，听见你们说：再试一次。",
      "next": "xingyu_bless"
    },
