    "warm_001": {
      "type": "dialogue",
      "background": "bg-warm.svg",
      "speaker": "narrator",
      "text": "这个星球的光有点模糊，像隔着一层很轻的雾，里面的东西似乎看得不是很清楚。",
      "next": "warm_001_extra_01"
