    "birthday_001": {
      "type": "dialogue",
      "background": "bg-cover.svg",
      "photoScene": "birthday_family_photo",
      "speaker": "narrator",
      "text": "很多年以后，那个小天使长到了八岁。她也许不记得星星图书馆和心愿之门，可那一天的选择，一直安静地睡在她的梦里。",
      "next": "birthday_002"
    },
    "birthday_002": {
      "type": "dialogue",
      "background": "bg-cover.svg",
      "photoScene": "birthday_family_photo",
      "speaker": "narrator",
      "text": "亲爱的宝贝，八岁生日快乐。你不是偶然来到这个家的。很久以前，有一个小天使穿过星星，认真看过很多家的光，最后选择了我们。",
      "next": "birthday_003"
    },
    "birthday_003": {
      "type": "dialogue",
      "background": "bg-cover.svg",
      "photoScene": "birthday_family_photo",
      "speaker": "narrator",
      "text": "谢谢你成为我们的孩子，也谢谢你让我们成为爸爸妈妈。希望你以后走到很远很远的地方，也永远知道：这个家，会一直为你亮着灯。",
      "next": "birthday_final"
    },
    "birthday_final": {
      "type": "final_card",
      "title": "这是爸爸妈妈送给你的，世界上独一无二的游戏。",
      "wishText": "祝宝贝八岁生日快乐。",
      "subtitle": "愿你每一次想起它，都知道：你被认真地选择，也被认真地爱着。",
      "buttonText": "回到星空"
    },
    "world_003_extra_01": {
      "type": "dialogue",
      "background": "bg-heaven.svg",
      "speaker": "narrator",
      "text": "每一颗星星，都代表着一个家庭。小天使们要认真看过许多家的光，然后选择自己要出生的地方。",
      "next": "cloud_001"
    },
    "family01_001_extra_01": {
      "type": "dialogue",
      "background": "bg-rainbow.svg",
      "speaker": "narrator",
      "text": "家里有很多个房间，每一个房间里，都有一个崭新的马桶，像一朵严肃的小白云。",
      "next": "family01_002"
    },
    "warm_003b_extra_01": {
      "type": "dialogue",
      "background": "bg-warm.svg",
      "photoScene": "warm_family_photos",
      "speaker": "narrator",
      "text": "右边相框里，是妈妈小时候的照片。那时她也还不是妈妈，只是一个小女孩，眼睛亮亮的，像刚刚发现了一件好玩的事。",
      "next": "warm_003c"
    },
    "warm_001_extra_01": {
      "type": "dialogue",
      "background": "bg-warm.svg",
      "speaker": "narrator",
      "text": "星球里没有城堡，也没有会唱歌的云。这里只有一间普通房间。",
      "next": "warm_001_extra_01_page_02"
    },
    "warm_001_extra_01_page_02": {
      "type": "dialogue",
      "background": "bg-warm.svg",
      "speaker": "narrator",
      "text": "桌边亮着一盏小灯。灯光里放着两只小相框，一左一右，像两颗还没有完全醒来的星星。",
      "next": "warm_002"
    },
    "warm_003d_extra_01": {
      "type": "dialogue",
      "background": "bg-warm.svg",
      "photoScene": "warm_family_photos",
      "speaker": "guardian",
      "text": "看见他们小时候的样子，你就知道：他们不是天生就会当爸爸妈妈。他们是带着自己的童年，一点点走来等你的。",
      "next": "warm_003e",
      "sprite": {
        "character": "guardian",
        "expression": "smile",
        "position": "right"
      }
    }
